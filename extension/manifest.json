{
  "manifest_version": 3,
  "name": "Fontlex Reading Hints",
  "version": "0.2.0",
  "description": "Read any web page in a hint font: English or French pronunciation, German noun genders or syllables.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["fonts.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_end",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["fonts/*.woff2"],
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "use_dynamic_url": true
  }]
}
